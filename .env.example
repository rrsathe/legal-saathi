# ==============================================================================
# Legal Saathi: Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   PowerShell: Copy-Item .env.example .env
#   CMD:        copy .env.example .env

# LLM Provider Selection ("groq" | "ollama" | "openai" | "gemini")
DEFAULT_LLM_PROVIDER=groq
DEFAULT_MODEL_NAME=llama-3.1-8b-instant

# Cloud API Keys
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local Ollama Inference (http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# RAG & Indexing Parameters
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
VECTOR_DB_PATH=data/index/chroma
BM25_INDEX_PATH=data/index/bm25.pkl
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=5

# Native Windows Portability
PYTHONUTF8=1
